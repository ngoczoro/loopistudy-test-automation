# App under test
# FE: use localhost — Vite on Windows often listens on [::1] only (not 127.0.0.1)
# API: use 127.0.0.1 — avoids Playwright Node resolving localhost → ::1 inconsistently
BASE_URL=http://localhost:5173
API_URL=http://127.0.0.1:5000

# Seeded users (from backend: npm run db:seed:demo)
STUDENT_EMAIL=alex.demo@loopi.com
STUDENT_PASSWORD=Demo1234!
ADMIN_EMAIL=admin@loopi.com
ADMIN_PASSWORD=admin123
LOCKED_EMAIL=sam.demo@loopi.com
LOCKED_PASSWORD=Demo1234!

# Set to true when backend + frontend are running (auth/e2e need this)
# Also run backend: npm run db:seed:demo
REQUIRE_SERVICES=false

# CI notes:
# - Default PR job runs smoke with REQUIRE_SERVICES=false (no live stack).
# - Manual workflow_dispatch E2E uses repo secrets E2E_BASE_URL / E2E_API_URL / …
